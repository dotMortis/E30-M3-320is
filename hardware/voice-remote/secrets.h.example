#pragma once
// Copy this file to secrets.h (same folder, gitignored) and fill in real
// values before flashing either device. secrets.h is included by both
// remote/src/main.cpp and receiver/src/main.cpp via a relative path.
//
// Generate the two keys with:
//   openssl rand -hex 16
//   openssl rand -hex 16
// (run it twice - PMK and LMK must be different, 16 random bytes each)
//
// Provisioning is a two-round flash, because each device needs to know the
// OTHER device's MAC address, and MAC addresses are only known once a device
// has been flashed and booted at least once (see ../PLAN.md "Provisioning"):
//   1. Fill in PMK/LMK/channel below; leave both MAC placeholders as-is for now.
//   2. Flash both boards once each with these placeholders, from this folder
//      (`pio run -d receiver -t upload -t monitor`, then
//       `pio run -d remote -t upload -t monitor`). Each prints its own MAC
//      address on a plain power-on/reset - note both down. (The remote only
//      prints on a reset, not on a button wake: a button wake takes the
//      low-latency path that skips USB entirely.)
//   3. Fill in VOICE_REMOTE_RECEIVER_MAC and VOICE_REMOTE_REMOTE_MAC below
//      with the two MACs you just read.
//   4. Re-flash BOTH boards again (MACs are baked in at compile time) - now
//      they'll actually trust each other's packets.

// 16 random bytes each, MUST differ from each other. These placeholders are
// deliberately obviously-fake so a forgotten copy/paste is easy to spot.
#define VOICE_REMOTE_PMK \
  { 0xDE, 0xAD, 0xBE, 0xEF, 0xDE, 0xAD, 0xBE, 0xEF, 0xDE, 0xAD, 0xBE, 0xEF, 0xDE, 0xAD, 0xBE, 0xEF }
#define VOICE_REMOTE_LMK \
  { 0xFE, 0xED, 0xFA, 0xCE, 0xFE, 0xED, 0xFA, 0xCE, 0xFE, 0xED, 0xFA, 0xCE, 0xFE, 0xED, 0xFA, 0xCE }

// Fixed ESP-NOW channel both devices use (bare WIFI_STA, no AP association).
#define VOICE_REMOTE_WIFI_CHANNEL_OVERRIDE 6

// MAC address of the remote (ESP32 #2) - used by receiver/src/main.cpp to
// know which sender to trust/decrypt for.
#define VOICE_REMOTE_REMOTE_MAC \
  { 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF }

// MAC address of the receiver (ESP32 #1) - used by remote/src/main.cpp as the
// ESP-NOW send destination.
#define VOICE_REMOTE_RECEIVER_MAC \
  { 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 }

// Identifies which physical remote sent a packet (future-proofing for more
// than one remote sharing a receiver - not currently used beyond a sanity
// check). Keep in sync between remote and receiver.
#define VOICE_REMOTE_DEVICE_ID 1
